# LLM_PROVIDER: ollama | vllm | openai | brain180
# brain180 = M3 경로. Brain180 프로그램의 AI 튜터를 로봇 브레인으로 사용.
# vllm    = 4090 로컬 Qwen3.6 멀티모달. 텍스트+카메라 비전 모두 로컬 처리
#           (빠름·프라이빗·무과금). /api/see 이미지가 로컬 vLLM으로 감.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=qwen36
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT=120

# Fast cloud fallback for meetings. Set LLM_PROVIDER=openai and restart backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=280
OPENAI_TIMEOUT=30
OPENAI_IMAGE_DETAIL=low

# ── Brain180 브리지 (ALI-21) — LLM_PROVIDER=brain180 일 때 사용 ────
# Railway 배포면 https://<your-app>.up.railway.app, 4090 로컬 구동이면 http://127.0.0.1:3001
BRAIN180_BASE_URL=http://127.0.0.1:3001
# Brain180 서버의 ROBOT_DEVICE_TOKEN 과 동일한 값을 넣을 것 (공유 비밀, 커밋 금지)
BRAIN180_DEVICE_TOKEN=
BRAIN180_TIMEOUT=120
# 로봇 대화 메모리: 최근 N턴(=user+assistant 2N개)을 history 로 전달
ROBOT_HISTORY_TURNS=6
SYSTEM_PROMPT=You are a concise Korean voice assistant running locally for Alien Agentic. Answer naturally in Korean unless the user asks otherwise.

# faster-whisper model name. Use tiny or base for CPU-only testing.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Set MOCK_TRANSCRIPT to test the full loop without a microphone/STT install.
MOCK_TRANSCRIPT=

# API token for /api/turn, /api/see, /audio. Leave BLANK to disable auth
# (LAN-only). The gateway is reachable publicly via Tailscale Funnel
# (https://alien-4090...ts.net:8443), so when that is on, SET a long random
# value here and put the SAME value in the CoreS3 firmware's DEVICE_TOKEN
# (config_cores3.h) — the firmware sends it as the X-Device-Token header.
# Accepted headers: X-Device-Token, X-API-Key, Authorization: Bearer. /health stays open.
API_TOKEN=

# Optional Piper TTS. Leave blank to return text only.
PIPER_BIN=
PIPER_MODEL=
PIPER_SPEAKER=
