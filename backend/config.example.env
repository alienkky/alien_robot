OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=qwen36
VLLM_API_KEY=EMPTY
SYSTEM_PROMPT=You are a concise Korean voice assistant running locally for Alien Agentic. Answer naturally in Korean unless the user asks otherwise.

# faster-whisper model name. Use tiny or base for CPU-only testing.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Set MOCK_TRANSCRIPT to test the full loop without a microphone/STT install.
MOCK_TRANSCRIPT=

# API token for /api/turn and /audio. Leave BLANK to disable auth (LAN-only use).
# When the server is exposed to the internet, set a long random value here and
# put the SAME value in firmware/include/config.h (API_TOKEN). /health stays open.
API_TOKEN=

# Optional Piper TTS. Leave blank to return text only.
PIPER_BIN=
PIPER_MODEL=
PIPER_SPEAKER=
